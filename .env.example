# --- App ---
APP_ENV=development
WEBHOOK_SECRET=change-me
ADMIN_SECRET=change-me-too
DB_PATH=leads.db

# --- LLM (provider: anthropic | openai) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Telegram (owner alerts) ---
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# --- Email replies (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# --- Scheduler / behaviour ---
ENABLE_SCHEDULER=0
ENABLE_RECOVERY=1
LEAD_WORKERS=4
FOLLOWUP_INTERVAL_MINUTES=15
FOLLOWUP_DELAY_HOURS=24
DUPLICATE_WINDOW_HOURS=24
